# Variables del frontend (Vite). Copia este archivo como .env para desarrollo local
# o defínelas en Netlify: Site configuration -> Environment variables.

# URL base de la API, incluyendo /api.
# Si no se define, la app usa la ruta relativa `/api`: el proxy de vite.config.js
# en desarrollo y la redirección de netlify.toml en producción la resuelven.
# Úsala solo para apuntar a otro backend (por ejemplo, un servicio nuevo de Render).
VITE_API_URL=https://urban-clothes-api.onrender.com/api
