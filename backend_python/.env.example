# Copia este archivo como .env y completa los valores reales.
# Nunca subas .env al repositorio.

# Puerto del servidor (3000 mantiene compatibilidad con el proxy de Vite).
PORT=3000

# Conexión PostgreSQL / Supabase
DB_USER=postgres.tu-proyecto
DB_PASSWORD=tu-password
DB_HOST=aws-0-tu-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Supabase exige SSL; pon false solo para un PostgreSQL local sin TLS.
DB_SSL=true

# Secreto para firmar los JWT (obligatorio, el servidor no arranca sin él).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# API key de Resend para el correo de recuperación de contraseña.
# Sin esta clave el endpoint /api/usuarios/recuperar-contrasena responde 500.
RESEND_API_KEY=re_tu_api_key

# Remitente verificado en Resend. `onboarding@resend.dev` solo entrega al correo
# del dueño de la cuenta; para usuarios reales verifica un dominio en Resend.
RESEND_FROM=Americanoshh Support <onboarding@resend.dev>

# Origen del frontend: se usa para armar el enlace del correo de recuperación.
FRONTEND_URL=https://americanos-hh.netlify.app

# development | production
ENTORNO=development
